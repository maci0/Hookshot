+++ b/tests/test_global_table_map.py
@@ -0,0 +1,23 @@
+"""Differential tests for width-specific first-match global table maps."""
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+RUN_ALL_ARGS = ['--cxx', '{cxx}']
+ROOT = Path(__file__).resolve().parents[1]
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--cxx', default='c++')
+    args = parser.parse_args()
+    with tempfile.TemporaryDirectory() as tmp:
+        exe = Path(tmp) / 'maps'
+        subprocess.run([args.cxx, '-std=c++20', '-O1', '-Wall', '-Wextra', '-Werror',
+                        '-I' + str(ROOT / 'gpu/vk'), str(ROOT / 'tests/global_table_map_test.cpp'),
+                        '-o', str(exe)], check=True)
+        subprocess.run([str(exe)], check=True)
+    print('PASS: ordered overlapping maps match the original resolver for all load widths')
+
+if __name__ == '__main__':
+    main()

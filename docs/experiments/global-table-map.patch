diff --git a/gpu/vk/global_table_map.h b/gpu/vk/global_table_map.h
new file mode 100644
index 0000000..2cde2f6
--- /dev/null
+++ b/gpu/vk/global_table_map.h
@@ -0,0 +1,57 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <span>
+#include <vector>
+
+// Inputs are the shader-visible table words and the actual immutable descriptor snapshot.
+struct GlobalTableBinding {
+    uint64_t address, size_word, bound_bytes, device_address;
+};
+struct GlobalTableRange {
+    uint64_t lo, hi, guest_base, device_address;
+};
+static_assert(sizeof(GlobalTableRange) == 32);
+
+// False leaves the existing shader search responsible for the entire table set.
+inline bool make_global_table_map(std::span<const GlobalTableBinding> bindings, uint64_t alignment,
+                                  uint32_t width, std::vector<GlobalTableRange>& result) {
+    result.clear();
+    if ((width != 4 && width != 8 && width != 16) || alignment < 16 || (alignment & (alignment - 1)))
+        return false;
+    std::vector<GlobalTableRange> ranges;
+    std::vector<uint64_t> ends;
+    const uint64_t max = std::numeric_limits<uint64_t>::max();
+    for (const auto& b : bindings) {
+        const uint64_t base = b.address & ~(alignment - 1);
+        const uint64_t bytes = b.bound_bytes / width * width;
+        if (!bytes) continue;
+        if (!b.device_address || b.device_address % width || b.bound_bytes > UINT32_MAX ||
+            b.size_word > UINT32_MAX || base > max - bytes || b.address > max - b.size_word ||
+            b.device_address > max - bytes)
+            return false;
+        const uint64_t end = b.size_word ? std::min(base + bytes, b.address + b.size_word) : base + bytes;
+        if (end <= base) continue;
+        ranges.push_back({base, end, base, b.device_address});
+        ends.push_back(base);
+        ends.push_back(end);
+    }
+    std::sort(ends.begin(), ends.end());
+    ends.erase(std::unique(ends.begin(), ends.end()), ends.end());
+    for (size_t i = 1; i < ends.size(); ++i) {
+        const uint64_t lo = ends[i - 1], hi = ends[i];
+        for (const auto& r : ranges) {
+            if (lo < r.lo || lo >= r.hi) continue;
+            if (!result.empty() && result.back().hi == lo && result.back().guest_base == r.guest_base &&
+                result.back().device_address == r.device_address) {
+                result.back().hi = hi;
+            } else {
+                result.push_back({lo, hi, r.guest_base, r.device_address});
+            }
+            break; // First matching descriptor wins, even when another covers more of the load.
+        }
+    }
+    return true;
+}
diff --git a/tests/global_table_map_test.cpp b/tests/global_table_map_test.cpp
new file mode 100644
index 0000000..a305771
--- /dev/null
+++ b/tests/global_table_map_test.cpp
@@ -0,0 +1,70 @@
+#include "global_table_map.h"
+#include <cassert>
+#include <random>
+
+static uint64_t original(std::span<const GlobalTableBinding> bindings, uint64_t alignment,
+                          uint32_t width, uint64_t address) {
+    for (const auto& b : bindings) {
+        const uint64_t base = b.address & ~(alignment - 1);
+        const uint64_t physical_end = base + b.bound_bytes / width * width;
+        const uint64_t end = b.size_word ? std::min(b.address + b.size_word, physical_end) : physical_end;
+        if (address >= base && address < end)
+            return b.device_address + (uint32_t(address - base) / width) * width;
+    }
+    return 0;
+}
+static uint64_t mapped(std::span<const GlobalTableRange> map, uint32_t width, uint64_t address) {
+    size_t lo = 0, hi = map.size();
+    while (lo < hi) {
+        const size_t mid = lo + (hi - lo) / 2;
+        const auto& r = map[mid];
+        if (address < r.lo) hi = mid;
+        else if (address >= r.hi) lo = mid + 1;
+        else return r.device_address + (uint32_t(address - r.guest_base) / width) * width;
+    }
+    return 0;
+}
+int main() {
+    std::mt19937_64 random(0x20261113);
+    for (unsigned trial = 0; trial < 1000; ++trial) {
+        const uint64_t high = trial % 2 ? 0x1000000000ull : 0;
+        const uint64_t alignment = trial % 3 ? 16 : 256;
+        std::vector<GlobalTableBinding> bs;
+        for (unsigned i = 0, n = random() % 65; i < n; ++i)
+            bs.push_back({high + random() % 4096, random() % 4 ? random() % 513 : 0,
+                          random() % 1025, 0x800000000ull + i * 0x10000ull});
+        for (uint32_t width : {4, 8, 16}) {
+            std::vector<GlobalTableRange> map;
+            assert(make_global_table_map(bs, alignment, width, map));
+            for (size_t i = 0; i < map.size(); ++i) {
+                assert(map[i].lo < map[i].hi);
+                if (i) assert(map[i-1].hi <= map[i].lo);
+            }
+            auto check = [&](uint64_t at) { assert(original(bs, alignment, width, at) == mapped(map, width, at)); };
+            for (unsigned i = 0; i < 128; ++i) check(high + random() % 6144);
+            for (const auto& r : map)
+                for (auto end : {r.lo, r.hi}) {
+                    if (end) check(end - 1);
+                    check(end);
+                    check(end + 1);
+                }
+        }
+    }
+    std::vector<GlobalTableRange> map;
+    // A logical end may lie inside the element read: do not split or reject that load.
+    const GlobalTableBinding crossing[] = {{0x1004,2,32,0x8000}, {0x1000,32,32,0x9000}};
+    assert(make_global_table_map(crossing,16,16,map));
+    assert(mapped(map,16,0x1005) == 0x8000);
+    assert(mapped(map,16,0x1006) == 0x9000);
+    // Width-specific truncation can change which descriptor wins.
+    const GlobalTableBinding short_range[] = {{0x1000,0,12,0x8000}, {0x1000,0,32,0x9000}};
+    assert(make_global_table_map(short_range,16,4,map) && mapped(map,4,0x1008) == 0x8008);
+    assert(make_global_table_map(short_range,16,16,map) && mapped(map,16,0x1008) == 0x9000);
+    for (auto bad : {GlobalTableBinding{0x1000,16,32,0},
+                     GlobalTableBinding{UINT64_MAX-8,32,32,0x8000},
+                     GlobalTableBinding{0x1000,0,0x100000000ull,0x8000},
+                     GlobalTableBinding{0x1000,16,32,UINT64_MAX-15}}) {
+        assert(!make_global_table_map(std::span(&bad,1),16,4,map));
+        assert(map.empty());
+    }
+}
